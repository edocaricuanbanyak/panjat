# =============================================================================
# PRODUCTION env checklist for Vercel (panjat.id). Set these in the Vercel
# project (Settings → Environment Variables), NOT in a committed file.
# Generate every secret fresh: `openssl rand -hex 32`. Never reuse dev values.
# See docs/QA-PRA-PRODUKSI.md for the full launch checklist.
# =============================================================================

# --- Data stores -------------------------------------------------------------
# Supabase: use the POOLER (Transaction, port 6543) URL for the app runtime.
# Serverless must pool. Keep ?sslmode=require. Run migrations from your machine
# against the DIRECT (5432) URL: `DATABASE_URL="<direct>" pnpm db:migrate`.
DATABASE_URL=postgresql://postgres.__ref__:__pw__@aws-0-__region__.pooler.supabase.com:6543/postgres?sslmode=require
# Redis is NOT provided by Supabase — provision Upstash (Vercel Marketplace).
REDIS_URL=rediss://default:__token__@__host__.upstash.io:6379

# --- URLs & payments ---------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://panjat.id

# Midtrans PRODUCTION keys (dashboard.midtrans.com). MOCK must be false.
MIDTRANS_SERVER_KEY=Mid-server-__PROD__
MIDTRANS_CLIENT_KEY=Mid-client-__PROD__
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_MOCK=false
# ONLY if the Merchant ID is shared with another live site (routes settlement
# notifications to Panjat's webhook per-transaction). Leave unset for a dedicated MID.
# MIDTRANS_NOTIFICATION_URL=https://panjat.id/api/webhook/midtrans

# --- Secrets (ROTATE all — `openssl rand -hex 32`) ---------------------------
KLIK_HASH_SECRET=__CHANGE_ME__      # daily click-hash salt (R10/§17.1)
SESSION_SECRET=__CHANGE_ME__        # dashboard session cookies (§18.2)
ANON_SECRET=__CHANGE_ME__           # anonymous visitor cookies (R14)
NOTIF_SECRET=__CHANGE_ME__          # unsubscribe links (R3)
ADMIN_SECRET=__CHANGE_ME__          # admin session cookie (§18.5)
CRON_SECRET=__CHANGE_ME__           # Vercel Cron Bearer token (§6). Unset = crons 503.

# --- Admin (§18.5) -----------------------------------------------------------
ADMIN_PASSWORD=__STRONG_PASSWORD__   # NOT "admin"
# REQUIRED before public launch. Generate: `pnpm admin:2fa`, scan the otpauth URL.
ADMIN_TOTP_SECRET=__CHANGE_ME__

# --- AI moderation (R8) ------------------------------------------------------
# Without this, layer-2 AI moderation fails safe to the manual "ragu" queue.
ANTHROPIC_API_KEY=__CHANGE_ME__

# --- Screenshots (R21, optional) ---------------------------------------------
# Vercel Blob for captured screenshots. The Playwright/Chromium screenshot worker
# is heavy for serverless — best-effort & non-blocking; can be deferred or hosted
# separately. Leave unset to skip (board never depends on it).
# BLOB_READ_WRITE_TOKEN=

# --- Product analytics (optional) --------------------------------------------
# Umami runs site-wide (cookieless; allowlisted in the CSP). To embed its dashboard
# on /statistik, enable Share URL in Umami Cloud and set NEXT_PUBLIC_UMAMI_SHARE_URL
# (frame-src already allows cloud.umami.is). Website ID has a hardcoded fallback.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SHARE_URL=https://cloud.umami.is/share/XXXXXXXX/panjat.id
#
# Google Analytics 4 — set the Measurement ID to enable gtag.js site-wide (CSP already
# allows googletagmanager + google-analytics). Embedding on /statistik is a later step.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# PostHog is OPTIONAL and OFF unless keyed. If you enable it, ALSO add its host to
# connect-src in src/middleware.ts (CSP currently allows only 'self' + Umami).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
