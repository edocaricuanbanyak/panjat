# Copy to .env.local and adjust. Values below match docker-compose.yml for local dev.
# Local dev credentials only — never use these in production.
# Ports 5433/6380 (not 5432/6379) avoid clashing with host Postgres/Redis installs.

DATABASE_URL=postgresql://panjat:panjat@localhost:5433/panjat
REDIS_URL=redis://localhost:6380

# Canonical base URL for sitemap/OG/share links. Set to https://panjat.id in prod.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Midtrans (sandbox for F1). Get keys from dashboard.sandbox.midtrans.com.
# The offline sim (pnpm manjat:sim) uses MIDTRANS_SERVER_KEY to sign its fake
# notifications, so any non-empty value works locally without real credentials.
MIDTRANS_SERVER_KEY=SB-Mid-server-localdevkey
MIDTRANS_CLIENT_KEY=SB-Mid-client-localdevkey
MIDTRANS_IS_PRODUCTION=false
# Dev only: skip real Midtrans; the manjat flow uses a local mock-pay page and
# /api/dev/settle to simulate settlement. Set false when using real sandbox keys.
MIDTRANS_MOCK=true
# Only needed when the Merchant ID is SHARED with another live site. Sends
# X-Override-Notification per transaction so Midtrans posts THIS app's settlement
# notifications to this URL regardless of the dashboard's single Notification URL
# (the other site keeps using the dashboard URL, untouched). Leave empty when the
# MID is dedicated to Panjat. Must be the full public webhook URL.
# MIDTRANS_NOTIFICATION_URL=https://panjat.id/api/webhook/midtrans

# Secret mixed into daily click-hash salt (R10 / §17.1). Rotate per environment.
KLIK_HASH_SECRET=dev-klik-secret

# Secret signing dashboard session cookies (§18.2). Rotate per environment.
SESSION_SECRET=dev-session-secret

# Claude API key for layer-2 AI moderation (R8, claude-haiku-4-5). If empty, the
# AI layer fails safe to "ragu" (manual queue) — layer 1 still runs.
ANTHROPIC_API_KEY=

# Secret signing notification unsubscribe links (R3). Rotate per environment.
# No email/WA provider is wired yet, so notifications log to the console.
NOTIF_SECRET=dev-notif-secret

# Secret signing anonymous visitor cookies (R14). Rotate per environment.
ANON_SECRET=dev-anon-secret

# Admin panel (§18.5). CHANGE all in prod.
ADMIN_PASSWORD=admin
ADMIN_SECRET=dev-admin-secret
# 2FA (TOTP). Empty = disabled (dev). REQUIRED in prod — generate with
# `pnpm admin:2fa`, set the secret here, scan the otpauth URL in an authenticator.
ADMIN_TOTP_SECRET=

# Scheduler auth (§6 hourly rosot + nightly jobs). Vercel Cron sends this as a
# Bearer token to /api/cron/*. REQUIRED in prod — unset = every cron route 503s
# (fail closed). Generate: `openssl rand -hex 32`.
CRON_SECRET=dev-cron-secret

# Screenshot storage (R21). If set, captured site screenshots go to Vercel Blob
# (own object storage + CDN); unset = local ./public/screenshots (dev only).
# Prod also needs `playwright install chromium` in the build (see docs/DEPLOY.md).
BLOB_READ_WRITE_TOKEN=

# Product analytics (PostHog — session time, bounce rate, funnels). Unset = disabled
# (no client tracking in dev/CI). Host: https://us.i.posthog.com or https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Umami (cookieless web analytics). The tracking script is wired site-wide; the ID
# below has a hardcoded fallback so it works out of the box.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Google Tag Manager — one container loads GA4 (and any other tags) site-wide.
# Set the container ID; the GA4 tag (measurement ID G-…) is configured INSIDE GTM,
# not here. Unset = GTM disabled. CSP already allows googletagmanager +
# google-analytics (script/connect/frame-src).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# GA4 Data API — first-party traffic stats on /statistik (server-side, no iframe).
# Both unset = the GA4 section is simply hidden. Setup:
#   1. Google Cloud: create a service account, enable "Google Analytics Data API".
#   2. GA4 → Admin → Property → Access Management → add the SA email as Viewer.
#   3. GA4_PROPERTY_ID = numeric property id (GA4 Admin → Property Settings).
#   4. GA4_SA_JSON = the whole service-account key JSON on one line.
# GA4_PROPERTY_ID=123456789
# GA4_SA_JSON={"type":"service_account", ...}
