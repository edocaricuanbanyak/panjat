# Copy to .env.local and adjust. Values below match docker-compose.yml for local dev.
# Local dev credentials only — never use these in production.
# Ports 5433/6380 (not 5432/6379) avoid clashing with host Postgres/Redis installs.

DATABASE_URL=postgresql://panjat:panjat@localhost:5433/panjat
REDIS_URL=redis://localhost:6380

# Midtrans (sandbox for F1). Get keys from dashboard.sandbox.midtrans.com.
# The offline sim (pnpm manjat:sim) uses MIDTRANS_SERVER_KEY to sign its fake
# notifications, so any non-empty value works locally without real credentials.
MIDTRANS_SERVER_KEY=SB-Mid-server-localdevkey
MIDTRANS_CLIENT_KEY=SB-Mid-client-localdevkey
MIDTRANS_IS_PRODUCTION=false
# Dev only: skip real Midtrans; the manjat flow uses a local mock-pay page and
# /api/dev/settle to simulate settlement. Set false when using real sandbox keys.
MIDTRANS_MOCK=true

# Secret mixed into daily click-hash salt (R10 / §17.1). Rotate per environment.
KLIK_HASH_SECRET=dev-klik-secret

# Secret signing dashboard session cookies (§18.2). Rotate per environment.
SESSION_SECRET=dev-session-secret
