# Copy to .env.local and adjust. Values below match docker-compose.yml for local dev.
# Local dev credentials only — never use these in production.
# Ports 5433/6380 (not 5432/6379) avoid clashing with host Postgres/Redis installs.

DATABASE_URL=postgresql://panjat:panjat@localhost:5433/panjat
REDIS_URL=redis://localhost:6380
